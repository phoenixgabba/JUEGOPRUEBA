extends SceneTree

const Data = preload("res://scripts/camp/phone/data.gd")
const Story = preload("res://scripts/camp/phone/story.gd")

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	var main = load("res://scenes/main.tscn").instantiate()
	root.add_child(main)
	main.start_game(false)
	main.close_dialog()
	assert(main.s.phone.data.contacts.is_empty())
	assert(main.s.phone.data.threads.is_empty())
	assert(main.s.phone.data.photos.is_empty())
	var key_event := InputEventKey.new()
	key_event.pressed = true
	key_event.keycode = KEY_P
	main._input(key_event)
	assert(not main.phone_ui.shown)
	main.s.phone.unlock("phone")
	main._input(key_event)
	assert(main.phone_ui.shown and main.phone_ui.at == "home")
	main.phone_ui.close()
	main.talk_to("Patricia")
	main.close_dialog()
	main.talk_to("Patricia")
	main.close_dialog()
	assert(main.s.phone.data.contacts.size() == 1)
	assert(main.s.phone.data.threads.Patricia.items.size() == 1)
	var data: Data = main.s.phone
	data.message("Patricia","Tú","¿A qué hora es la convocatoria?")
	Story.reply(data,"Patricia")
	assert(data.data.threads.Patricia.items.size() == 3)
	var document := "file:turnos"
	Story.sync(data,1,"commissions",1,0)
	assert(data.data.threads.org.items[0].attachment == document and data.data.mail[0].attachment == document)
	data.mail("Organización","Consulta","Sobre los turnos",document,true)
	data.data.drafts.mail = {"subject":"Borrador","to":"Cuidados","body":"Consulta"}
	data.data.notes.append({"id":data.id(),"body":"Llevar la ficha."})
	var image := Image.create_empty(48,32,false,Image.FORMAT_RGB8)
	image.fill(Color("e3bc73"))
	var photo_id := data.photo(image)
	assert(not photo_id.is_empty() and data.image_by_id(photo_id).get_size() == image.get_size())
	var temporary_id := data.photo(image)
	assert(data.delete_photo(temporary_id))
	data.publish(photo_id,"La plaza por la tarde",false)
	data.publish(photo_id,"Una historia",true)
	assert(not data.delete_photo(photo_id))
	assert(data.data.social.size() == 1 and data.data.stories.size() == 1)
	assert(data.data.followers == ["Patricia"])
	data.schedule("reminder","Asamblea",1,16,"Acude al círculo",true)
	data.tick(0.5,1,16)
	data.tick(1,1,16)
	assert(data.data.agenda.reminder.fired)
	assert(data.data.notices.filter(func(n): return n.target=="reminder").size()==1)
	main.open_phone()
	var device = main.phone_ui
	device.start_call("Patricia",false)
	device.step(2.1,true)
	assert(device.call_state=="En llamada")
	device.finish_call("Finalizada")
	device.navigate("notices")
	var inbox: VBoxContainer = device.content
	var first: Button = inbox.get_child(0)
	first.pressed.emit()
	assert(device.at=="agenda" and device.target=="reminder")
	device.close()
	main.s.save_game()
	var restored := CampState.new()
	assert(restored.load_game())
	assert(restored.phone.data.contacts.has("Patricia"))
	assert(restored.phone.data.threads.Patricia.items[1].body == "¿A qué hora es la convocatoria?")
	assert(restored.phone.data.mail.size()==2 and restored.phone.data.drafts.mail.body=="Consulta")
	assert(restored.phone.data.notes[0].body=="Llevar la ficha.")
	assert(restored.phone.image_by_id(photo_id)!=null and restored.phone.data.social[0].photo==photo_id)
	assert(restored.phone.data.calls[0].name=="Patricia")
	var normal := FileAccess.get_file_as_string(CampState.SAVE_PATH)
	main.test_build = true
	main.load_checkpoint(13)
	assert(main.s.practice and device.shown and device.call_state=="Entrante")
	for app in ["contacts","social","messages","mail","camera","gallery","map","agenda","notes","files","settings","clock","calls","notices"]:
		device.navigate(app)
		assert(device.at == app)
	main.s.phone.data.contacts.clear()
	device.close()
	assert(FileAccess.get_file_as_string(CampState.SAVE_PATH)==normal)
	main.queue_free()
	await process_frame
	print("[phone] PASS: apertura, contactos progresivos, conversaciones, correo, foto, redes, llamadas, agenda, persistencia y selector aislado")
	quit()
